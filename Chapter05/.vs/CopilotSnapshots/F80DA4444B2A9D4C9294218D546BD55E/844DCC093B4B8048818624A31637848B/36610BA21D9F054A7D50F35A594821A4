using System;
using System.Collections.Generic;
using System.Text;
using System.Globalization;

namespace PeopleApp
{
    partial class ProgramA
    {
        private static void ConfigureConsole(string culture = "es-Us", bool useComputerCulture = false, bool showCulture =  true) 
        { 
            OutputEncoding = System.Text.Encoding.UTF8;

            if (!useComputerCulture) 
            {
                CultureInfo.CurrentCulture = CultureInfo.GetCultureInfo(culture);
            }

            if (showCulture)
            {
                WriteLine($"Curent Culture: {CultureInfo.CurrentCulture.DisplayName}");
            }
        }
    }
}
